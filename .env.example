# VitaDock Online account (cloud.vitadock.com)
VITADOCK_EMAIL=you@example.com
VITADOCK_PASSWORD=

# Garmin Connect (only needed for the first login / when tokens expire)
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=

# Optional: different token location (path), or the token JSON itself
# GARMINTOKENS=~/.garminconnect
